# Copy to .env and replace secret values with unique credentials.
API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3307
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_READONLY_USER=atlas_readonly
MYSQL_READONLY_PASSWORD=
DB_HOST=db

# Optional Langfuse tracing. Leave blank to disable it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
